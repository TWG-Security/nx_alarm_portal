# Copy to .env and fill in. Never commit .env.
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"                               -> SECRET_KEY, POSTGRES_PASSWORD
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  -> FERNET_KEY
SECRET_KEY=
FERNET_KEY=
POSTGRES_PASSWORD=

# Google Maps JavaScript API key (enable "Maps JavaScript API" and "Geocoding API";
# restrict it by HTTP referrer to the portal's address) and a Map ID
# (Google Cloud console > Google Maps Platform > Map management). DEMO_MAP_ID works for testing.
MAPS_API_KEY=
MAPS_MAP_ID=DEMO_MAP_ID

# Address the portal is served on (used by Caddy for its certificate).
PORTAL_HOST=10.1.10.97

# Optional tuning
# POLL_INTERVAL_S=5
# INITIAL_LOOKBACK_MS=0
