# Copy to .env and fill in. Never commit .env.
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"                               -> SECRET_KEY, POSTGRES_PASSWORD
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  -> FERNET_KEY
SECRET_KEY=
FERNET_KEY=
POSTGRES_PASSWORD=

# Maps use OpenStreetMap tiles and Nominatim address search: no API key needed.
# For heavy use, point these at a commercial or self-hosted provider (OSM's servers are donated and rate-limited).
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Address the portal is served on (used by Caddy for its certificate).
PORTAL_HOST=10.1.10.97

# Optional tuning
# POLL_INTERVAL_S=5
# INITIAL_LOOKBACK_MS=0

# Sign-in protection (also editable on the Platform page)
# TRUSTED_PROXY_IPS=10.0.2.58          # the Cloudflare Tunnel connector: only it may send CF-Connecting-IP
# IP_ALLOWLIST=                        # addresses or ranges that are never blocked
# FORWARDED_ALLOW_IPS=172.16.0.0/12    # who may set X-Forwarded-For (Caddy on the docker network)

# Passkeys only work on this host name (the page hides them elsewhere, e.g. on the LAN IP)
# WEBAUTHN_RP_ID=alarmportal.twgsecurity.net
# WEBAUTHN_ORIGINS=https://alarmportal.twgsecurity.net
